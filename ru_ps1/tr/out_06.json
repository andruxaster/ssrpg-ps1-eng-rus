{
 "1188": {
  "pages": [
   "Хи-хи... спасибо, Галфорд."
  ]
 },
 "1189": {
  "pages": [
   "В новой униформе я сама Справедливость!"
  ]
 },
 "1190": {
  "pages": [
   "Кха... Да, мне нравится."
  ]
 },
 "1191": {
  "pages": [
   "Хм... сойдет."
  ]
 },
 "1192": {
  "pages": [
   "Ура!",
   "А ушки и хвостик от Чоны-Чоны Чам-Чам сбережет!"
  ]
 },
 "1193": {
  "pages": [
   "С этим цветом...",
   "лучше всего ушки и хвостик от Чоны-Чоны!"
  ]
 },
 "1194": {
  "pages": [
   "Хм... и впрямь не хуже парижского портного.",
   "Хвалились они не зря."
  ]
 },
 "1195": {
  "pages": [
   "Эй... а тебе идет, Шарлотта!",
   "Красавице, видать, все к лицу, а?"
  ]
 },
 "1196": {
  "pages": [
   "Н-не говори глупостей..."
  ]
 },
 "1197": {
  "pages": [
   "Превосходно! Кудзухара не подвели.",
   "Отличный пошив, как всегда! Браво!"
  ]
 },
 "1198": {
  "pages": [
   "Благодарим, как всегда, господин Кесиро...",
   "Мы сделали вам обычную скидку в полцены."
  ]
 },
 "1199": {
  "pages": [
   "Ура! Ну как? Мне идет?"
  ]
 },
 "1200": {
  "pages": [
   "Хи-хи... ох, Римуруру... Да, тебе очень идет."
  ]
 },
 "1201": {
  "pages": [
   "Белый пар встает, ласкова в пути купель - прочь уносит жар."
  ]
 },
 "1202": {
  "pages": [
   "Эй, гость! Деньги, деньги!"
  ]
 },
 "1203": {
  "pages": [
   "...Эй, эй! За баню-то заплатить надо!"
  ]
 },
 "1204": {
  "pages": [
   "Мы пока закрыты!"
  ]
 },
 "1205": {
  "pages": [
   "Хе-хе-хе... понимаешь,",
   "там бушевал огромный черный сом.",
   "И после тяжелой схватки ваш покорный слуга...",
   "Вжик!",
   "...его и прикончил, вот..."
  ]
 },
 "1206": {
  "pages": [
   "На самом деле то землетрясение устроили демоны...",
   "А великий Хаомару их..."
  ]
 },
 "1207": {
  "pages": [
   "Хм... Плевать мне на землетрясения...",
   "Гигантского сома я разрубил бы одним ударом."
  ]
 },
 "1208": {
  "pages": [
   "...Хм. Ничего-то ты не знаешь.",
   "Демоны нацелились на Эдо."
  ]
 },
 "1209": {
  "pages": [
   "Хе... Землетрясения, может, и страшны...",
   "но нынче женщины куда страшнее."
  ]
 },
 "1210": {
  "pages": [
   "Только между нами...",
   "на Эдо наступала сила Ада."
  ]
 },
 "1211": {
  "pages": [
   "Но проблем!",
   "Если жить светло и честно, землетрясения не страшны!"
  ]
 },
 "1212": {
  "pages": [
   "Йес... вы тоже берегитесь.",
   "То землетрясение вызвали демоны."
  ]
 },
 "1213": {
  "pages": [
   "А то! Раз уж родился мужиком,",
   "без кувшина сакэ не прожить!",
   "Сакэ - лучший друг Хаомару и верный спутник в пути!"
  ]
 },
 "1214": {
  "pages": [
   "А то!",
   "...хотел бы я сказать, но по правде...",
   "Нет, не спрашивай почему.",
   "Я сейчас в завязке!"
  ]
 },
 "1215": {
  "pages": [
   "Сакэ... пустое."
  ]
 },
 "1216": {
  "pages": [
   "Да...",
   "Хорошее сакэ делает жизнь богаче."
  ]
 },
 "1217": {
  "pages": [
   "Простите...",
   "У меня хроническая болезнь. Много пить не могу."
  ]
 },
 "1218": {
  "pages": [
   "Конечно!",
   "И японцы, и американцы...",
   "все обожают сакэ!"
  ]
 },
 "1219": {
  "pages": [
   "...Я ведь ниндзя. Напиваться нельзя."
  ]
 },
 "1220": {
  "pages": [
   "Ага! Я хочу стать сильнее!",
   "Потому и дерусь с сильными!",
   "Выиграю или проиграю - не пожалею!",
   "...Ты, женщина, может,",
   "и не поймешь, но..."
  ]
 },
 "1221": {
  "pages": [
   "...Раз зовешь себя мечником, будешь драться.",
   "А в драке...",
   "либо рубишь ты, либо тебя.",
   "Ничего не попишешь."
  ]
 },
 "1222": {
  "pages": [
   "Хе... тех, кто мне не по нраву..."
  ]
 },
 "1223": {
  "pages": [
   "Кто встанет у меня на пути... того зарублю."
  ]
 },
 "1224": {
  "pages": [
   "...Я ведь как-никак мечник."
  ]
 },
 "1225": {
  "pages": [
   "...Искры, что летят на тебя, нужно стряхивать."
  ]
 },
 "1226": {
  "pages": [
   "Йес!",
   "Я, Галфорд, не дам злу уйти безнаказанным!"
  ]
 },
 "1227": {
  "pages": [
   "Ради справедливости иначе нельзя."
  ]
 },
 "1228": {
  "pages": [
   "Вот как... да, верно.",
   "Мой учитель говорил: чужую боль не поймешь, пока не испытаешь.",
   "Так он мне и сказал."
  ]
 },
 "1229": {
  "pages": [
   "...Думаешь?",
   "Как-то до меня не доходит."
  ]
 },
 "1230": {
  "pages": [
   "Хе... возможно."
  ]
 },
 "1231": {
  "pages": [
   "Хм... вздор."
  ]
 },
 "1232": {
  "pages": [
   "...Пожалуй.",
   "Те, кто добрее всех...",
   "быть может, больше всех страдают и мечутся...",
   "...наверное."
  ]
 },
 "1233": {
  "pages": [
   "Нет...",
   "В конце концов, чужое страдание другим не понять...",
   "С добротой так же. Что бы ни было на душе,",
   "это не всегда доходит."
  ]
 },
 "1234": {
  "pages": [
   "Йес...",
   "Быть добрым к другим, как бы тяжело ни было...",
   "это и есть настоящая сила духа, я тоже так думаю!"
  ]
 },
 "1235": {
  "pages": [
   "Бат если улыбаться, когда грустно,",
   "до других дойдет только половина чувств.",
   "Я думаю, лучше жить",
   "в хэппи настроении!"
  ]
 },
 "1236": {
  "pages": [
   "Если кто показал тебе слабость, хочется помочь.",
   "Это ж нормально, разве нет?"
  ]
 },
 "1237": {
  "pages": [
   "Не выношу, когда плачут...",
   "Пусть уж лучше улыбаются."
  ]
 },
 "1238": {
  "pages": [
   "Хм...",
   "Докучливых баб так и хочется зарубить."
  ]
 },
 "1239": {
  "pages": [
   "...Говоря в общем,",
   "разве мужчин не влечет",
   "к хрупким женщинам?"
  ]
 },
 "1240": {
  "pages": [
   "...Говоря в общем,",
   "разве мужчин не влечет",
   "к сияющей женской улыбке?"
  ]
 },
 "1241": {
  "pages": [
   "Как герой справедливости я не могу пройти мимо",
   "плачущей леди."
  ]
 },
 "1242": {
  "pages": [
   "Улыбку леди я люблю больше, чем ее слезы."
  ]
 },
 "1243": {
  "pages": [
   "Хе-хе-хе...",
   "Я только начал!"
  ]
 },
 "1244": {
  "pages": [
   "Ну... раз красавица наливает,",
   "я, может, и перебрал малость."
  ]
 },
 "1245": {
  "pages": [
   "Хм... я выпил больше, чем следовало."
  ]
 },
 "1246": {
  "pages": [
   "...Ну... еще немного, пожалуй."
  ]
 },
 "1247": {
  "pages": [
   "Похоже... я немного перебрал."
  ]
 },
 "1248": {
  "pages": [
   "Я не бездонный, но пока окей!"
  ]
 },
 "1249": {
  "pages": [
   "Уф...",
   "Вообще-то мне уже ноу сэнк ю."
  ]
 },
 "1250": {
  "pages": [
   "Вот как?",
   "Тогда давай заберемся на вершину Фудзи!"
  ]
 },
 "1251": {
  "pages": [
   "Дура!",
   "Не мели чепухи!"
  ]
 },
 "1252": {
  "pages": [
   "Хи-хи...",
   "Тогда пойдемте посмотрим на сакуру у замка Эдо?"
  ]
 },
 "1253": {
  "pages": [
   "Ха-ха-ха!",
   "Тогда я свожу тебя на свою родину!"
  ]
 },
 "1254": {
  "pages": [
   "...Думаешь? Я всего лишь бродячий мечник.",
   "Не переоценивай меня."
  ]
 },
 "1255": {
  "pages": [
   "Хе-хе-хе... аж неловко.",
   "Вроде как похвалили. Щекотно!"
  ]
 },
 "1256": {
  "pages": [
   "Дура!",
   "Скажи такую чушь еще раз,",
   "и твой язык больше никогда не шевельнется!"
  ]
 },
 "1257": {
  "pages": [
   "...Это лесть?",
   "Как бы то ни было, слышать такое",
   "мне не слишком приятно."
  ]
 },
 "1258": {
  "pages": [
   "...Сильный взгляд... говорите?"
  ]
 },
 "1259": {
  "pages": [
   "Ноу...",
   "То, что у меня синие глаза, не делает их особенными."
  ]
 },
 "1260": {
  "pages": [
   "Хе, это жаркое пламя справедливости горит во мне!"
  ]
 },
 "1261": {
  "pages": [
   "Не деньги мне нужны.",
   "А... кое-что другое."
  ]
 },
 "1262": {
  "pages": [
   "Не люблю жадничать из-за денег,",
   "но без них такого хорошего сакэ не выпьешь."
  ]
 },
 "1263": {
  "pages": [
   "Хм... деньги...",
   "...Скука."
  ]
 },
 "1264": {
  "pages": [
   "Хе... твоя правда. За деньги можно купить что угодно."
  ]
 },
 "1265": {
  "pages": [
   "Деньги нужны, но...",
   "есть вещи куда важнее для меня."
  ]
 },
 "1266": {
  "pages": [
   "В жизни, похоже, деньги всегда на что-нибудь нужны."
  ]
 },
 "1267": {
  "pages": [
   "Лишь бы золото не ослепило, тогда окей."
  ]
 },
 "1268": {
  "pages": [
   "Ха-ха! С золотом",
   "добраться до Японии было бы куда легче!"
  ]
 },
 "1269": {
  "pages": [
   "Ха! Какая нелепость!",
   "Я прогуляюсь поблизости. Делайте что хотите."
  ]
 },
 "1270": {
  "pages": [
   "Хи-хи... одна краше другой. Какая девушка вам по душе?"
  ],
  "question": "Ну... что будете делать?",
  "options": [
   "Кто они?",
   "Выбрать"
  ]
 },
 "1271": {
  "pages": [
   "Ох... какая девушка вам приглянулась?"
  ],
  "options": [
   "Средняя",
   "Правая"
  ]
 },
 "1272": {
  "pages": [
   "С какой девушкой проведете время?"
  ],
  "options": [
   "Средняя",
   "Правая"
  ]
 },
 "1273": {
  "pages": [
   "Ч-что?! Но почему?"
  ]
 },
 "1274": {
  "pages": [
   "...Простите... нет, то есть...",
   "Приходите еще! Обещайте!"
  ]
 },
 "1275": {
  "pages": [
   "...Вот как. Что ж, прощайте..."
  ]
 },
 "1276": {
  "pages": [
   "А?",
   "Уже...? Побудьте еще немножко!"
  ]
 },
 "1277": {
  "pages": [
   "Что?!",
   "Нет... вы шутите!",
   "Мне будет так одиноко!"
  ]
 },
 "1278": {
  "pages": [
   "Что?! Ох, нет!",
   "Только я наконец... к вам..."
  ]
 },
 "1279": {
  "pages": [
   "...Вы такой сильный... а я... я люблю сильных...",
   "Я... люб...лю... вас..."
  ]
 },
 "1280": {
  "pages": [
   "Я еще не встречала такого нежного мужчины...",
   "Прошу, еще раз...",
   "согрейте меня своим теплом..."
  ]
 },
 "1281": {
  "pages": [
   "Н-ну тогда... эм...",
   "Я... погашу свет..."
  ]
 },
 "1282": {
  "pages": [
   "Н-ну тогда... эм...",
   "Придумала! Пойдемте посмотрим на Эдо!",
   "Так и сделаем!"
  ]
 },
 "1283": {
  "pages": [
   "...Если дело в здоровье, ничего не поделаешь...",
   "Но..."
  ]
 },
 "1284": {
  "pages": [
   "......",
   "Я... немного перебрала...",
   "На сегодня хватит..."
  ]
 },
 "1285": {
  "pages": [
   "Нет... эм...",
   "...Позвольте составить вам компанию в другой раз..."
  ]
 },
 "1286": {
  "pages": [
   "У нас тут играют в чет-нечет..."
  ],
  "question": "Объяснить правила?",
  "options": [
   "Да",
   "Нет"
  ]
 },
 "1287": {
  "pages": [
   "Бросаешь две кости",
   "и угадываешь, сумма четная или нечетная.",
   "Вот и вся премудрость.",
   "Сыграешь пару раз - и сразу освоишься."
  ]
 },
 "1288": {
  "pages": [
   "О, гость...",
   "Хе-хе-хе, давненько не виделись."
  ]
 },
 "1289": {
  "pages": [
   "Теперь - чет!"
  ]
 },
 "1290": {
  "pages": [
   "Следом - нечет!"
  ]
 },
 "1291": {
  "pages": [
   "Кто на чет? На чет!"
  ]
 },
 "1292": {
  "pages": [
   "Кто на нечет? На нечет!"
  ]
 },
 "1293": {
  "pages": [
   "Ну что, гость... что выберете?"
  ]
 },
 "1294": {
  "pages": [],
  "options": [
   "Нечет!",
   "Жульничество"
  ]
 },
 "1295": {
  "pages": [
   "Гость... может, на сегодня хватит,",
   "и отпустите нас...?"
  ]
 },
 "1296": {
  "pages": [
   "Уходите?",
   "Заходите еще поиграть."
  ]
 },
 "1297": {
  "pages": [
   "В следующий раз выиграете, гость!"
  ]
 },
 "1298": {
  "pages": [
   "Я вас недооценил...",
   "В следующий раз будьте помягче."
  ]
 },
 "1299": {
  "pages": [
   "Гость, пройдите-ка сюда..."
  ]
 },
 "1300": {
  "pages": [
   "Приносим глубочайшие извинения...",
   "Наш метатель костей пошалил.",
   "Примите это и простите нас."
  ]
 },
 "1301": {
  "pages": [
   "Вы устраиваете скандал...",
   "Мешаете другим гостям!",
   "А ну, проваливайте!"
  ]
 },
 "1302": {
  "pages": [
   "Ну как, гость?",
   "Сыграете со мной один на один?",
   "Ставка начинается с 20",
   "и растет с каждой вашей победой...",
   "Примете вызов?"
  ]
 },
 "1303": {
