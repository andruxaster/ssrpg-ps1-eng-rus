  "options": [
   "Нет",
   "Да"
  ]
 },
 "1307": {
  "pages": [],
  "question": "Ставка 320. Повысить?",
  "options": [
   "Нет",
   "Да"
  ]
 },
 "1308": {
  "pages": [
   "Играем на 20 GP."
