 },
 "2368": {
  "pages": [
   "Ох... господин Гэн-ан..."
  ]
 },
 "2369": {
  "pages": [
   "Гэн-ан... Сирануи Гэн-ан..."
  ]
 },
 "2370": {
  "pages": [
   "К-кто там, кэ?"
  ]
 },
 "2371": {
  "pages": [
   "Жаждешь крови...? Желаешь рвать плоть...?"
  ]
 },
 "2372": {
  "pages": [
   "Кто ты, кэ?"
  ]
 },
 "2373": {
  "pages": [
   "Мое имя... владыка тьмы... А...м...б...з...я..."
  ]
 },
 "2374": {
  "pages": [
   "...? (Не расслышал, кэ.)"
  ]
 },
 "2375": {
  "pages": [
