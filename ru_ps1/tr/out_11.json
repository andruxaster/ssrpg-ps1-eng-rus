{
 "2178": {
  "pages": [
   "В глухих краях Хиды стоит храм Кокаин.",
   "И в одном его уголке появилась еще одна крохотная могилка демона."
  ]
 },
 "2179": {
  "pages": [
   "Поминальная служба по демонам... Странно звучит.",
   "Кто желает поминовения - убитые демоны?",
   "...Или те, кто их убил...?"
  ]
 },
 "2180": {
  "pages": [
   "Кофеин Никотин лишь улыбнулся и ничего не ответил."
  ]
 },
 "2181": {
  "pages": [
   "Здесь, в Гималаях... на высоте 8848 метров над уровнем моря..."
  ]
 },
 "2182": {
  "pages": [
   "Я дома!"
  ]
 },
 "2183": {
  "pages": [
   "О, братец Дзиро! С возвращением. Устал, наверное?"
  ]
 },
 "2184": {
  "pages": [
   "Баньку приготовить?"
  ]
 },
 "2185": {
  "pages": [
   "Или сначала поужинаешь?"
  ]
 },
 "2186": {
  "pages": [
   "Спасибо, Сабуро...",
   "Так... Пожалуй, баньку!"
  ]
 },
 "2187": {
  "pages": [
   "Сейчас все приготовлю..."
  ]
 },
 "2188": {
  "pages": [
   "А все-таки в этот раз нам не надо быть судьями...",
   "так что работа, можно сказать, легкая..."
  ]
 },
 "2189": {
  "pages": [
   "Да... Хотя немного обидно..."
  ]
 },
 "2190": {
  "pages": [
   "Братец Итиро тоже расстроился.",
   "Говорит, нет 'упоения, когда душа купается в смертельной схватке'",
   "или что-то в этом роде."
  ]
 },
 "2191": {
  "pages": [
   "Это верно... В этот раз мы всего лишь летописцы."
  ]
 },
 "2192": {
  "pages": [
   "Я дома-а!"
  ]
 },
 "2193": {
  "pages": [
   "А, братец Дзиро..."
  ]
 },
 "2194": {
  "pages": [
   "С возвращением, Сиро!",
   "Сабуро как раз готовит нам баньку.",
   "Пойдешь со мной?"
  ]
 },
 "2195": {
  "pages": [
   "Правда? Здорово... Я сегодня что-то устал..."
  ]
 },
 "2196": {
  "pages": [
   "Ну-ну, так не годится. Что стряслось?"
  ]
 },
 "2197": {
  "pages": [
   "Меня заставили записывать за Чам-Чам,",
   "а это так утомительно-о!"
  ]
 },
 "2198": {
  "pages": [
   "Она болтает без умолку про всякую ерунду,",
   "записи все длиннее и длиннее. Попробуй все запомни!"
  ]
 },
 "2199": {
  "pages": [
   "Но и с молчунами тоже мука."
  ]
 },
 "2200": {
  "pages": [
   "...Братцу Итиро ведь достался Гэндзюро."
  ]
 },
 "2201": {
  "pages": [
   "Гэндзюро, значит..."
  ]
 },
 "2202": {
  "pages": [
   "Не хочу говорить худого, но...",
   "этот господин мне как-то не по душе...",
   "Взгляд у него какой-то... ну, такой, понимаешь..."
  ]
 },
 "2203": {
  "pages": [
   "Он сам сказал: 'Записывай!',",
   "а потом ни словечка не вымолвит!",
   "Это ж просто бесит!"
  ]
 },
 "2204": {
  "pages": [
   "Во-во! А если осмелишься что-то спросить,",
   "он как заорет: 'Болван!' Никакого с ним сладу!"
  ]
 },
 "2205": {
  "pages": [
   "Но..."
  ]
 },
 "2206": {
  "pages": [
   "Но?"
  ]
 },
 "2207": {
  "pages": [
   "Братец Итиро говорит: 'Этим-то он... и хорош.'"
  ]
 },
 "2208": {
  "pages": [
   "Братец Итиро все-таки взрослый, да?"
  ]
 },
 "2209": {
  "pages": [
   "Ага... совсем взрослый."
  ]
 },
 "2210": {
  "pages": [
   "Кстати, вот Хаомару...",
   "тот тоже по-своему хорош гусь..."
  ]
 },
 "2211": {
  "pages": [
   "А, этот...",
   "Ему надо верить через слово, а то потом страху натерпишься..."
  ]
 },
 "2212": {
  "pages": [
   "Если бы все было, как Хаомару рассказывает,",
   "одни 'жутко сильные мечники' да 'чудовищные демоны',",
   "никто бы эту ролевуху ни в жизнь не прошел!"
  ]
 },
 "2213": {
  "pages": [
   "Нюх-нюх... Кстати, братец..."
  ]
 },
 "2214": {
  "pages": [
   "Вот-вот..."
  ]
 },
 "2215": {
  "pages": [
   "Зрителям у телевизоров этого не понять, но...",
   "от того человека еще и пахнет жутко."
  ]
 },
 "2216": {
  "pages": [
   "А побудешь рядом - и запах к тебе пристает."
  ]
 },
 "2217": {
  "pages": [
   "Все в отряде держатся от него чуть подальше.",
   "Особенно барышни и Укио."
  ]
 },
 "2218": {
  "pages": [
   "Хе-хе-хе..."
  ]
 },
 "2219": {
  "pages": [
   "А что там с Шарлоттой?",
   "Братец, банька готова...",
   "О, Сиро, ты вернулся?"
  ]
 },
 "2220": {
  "pages": [
   "Я дома, братец Сабуро."
  ]
 },
 "2221": {
  "pages": [
   "Сабуро, тебе ведь досталась Накоруру?"
  ]
 },
 "2222": {
  "pages": [
   "Везет тебе, братец Сабуро."
  ]
 },
 "2223": {
  "pages": [
   "Хе-хе-хе... Кстати, про Накоруру,",
   "угадайте, что я услышал?"
  ]
 },
 "2224": {
  "pages": [
   "А? Что, что? Братец, что?"
  ]
 },
 "2225": {
  "pages": [
   "Эта Накоруру, понимаешь... она такая... ну..."
  ]
 },
 "2226": {
  "pages": [
   "Какая такая? Ну, говори уже..."
  ]
 },
 "2227": {
  "pages": [
   "Когда я записывал, она мне сказала... вот послушайте..."
  ]
 },
 "2228": {
  "pages": [
   "'Это... Это ведь секрет, правда? Вы никому...",
   "Никому ведь не скажете?'"
  ]
 },
 "2229": {
  "pages": [
   "И ее бледные щечки так и покраснели...",
   "Ну что ты будешь делать!"
  ]
 },
 "2230": {
  "pages": [
   "Правда? Нечестно, братец..."
  ]
 },
 "2231": {
  "pages": [
   "Да уж... ну... расскажи..."
  ]
 },
 "2232": {
  "pages": [
   "Нет-нет, только не это... Это привилегия работы..."
  ]
 },
 "2233": {
  "pages": [
   "Это еще что значит? Не ломайся, рассказывай, а?"
  ]
 },
 "2234": {
  "pages": [
   "Точно!",
   "Мы никому не скажем... честно!"
  ]
 },
 "2235": {
  "pages": [
   "Ну ладно, только самое интересное..."
  ]
 },
 "2236": {
  "pages": [
   "Шу-шу-шу..."
  ]
 },
 "2237": {
  "pages": [
   "А потом..."
  ]
 },
 "2238": {
  "pages": [
   "Что-о?! Как смело!"
  ]
 },
 "2239": {
  "pages": [
   "Не верится... Это же Накоруру!"
  ]
 },
 "2240": {
  "pages": [
   "И это еще не все! А вдобавок..."
  ]
 },
 "2241": {
  "pages": [
   "И к тому же... хотя..."
  ]
 },
 "2242": {
  "pages": [
   "...даже... ...и... ...наконец!!"
  ]
 },
 "2243": {
  "pages": [
   "Ага, ага. Просто потрясающе."
  ]
 },
 "2244": {
  "pages": [
   "Такая девушка... ...вот как..."
  ]
 },
 "2245": {
  "pages": [
   "Видно, Накоруру все-таки тоже женщина...",
   "да ведь..."
  ]
 },
 "2246": {
  "pages": [
   "Как-то даже обидно..."
  ]
 },
 "2247": {
  "pages": [
   "Ну-ну, Сиро... Так уж оно бывает."
  ]
 },
 "2248": {
  "pages": [
   "Сиро ведь тайный поклонник Накоруру."
  ]
 },
 "2249": {
  "pages": [
   "А ну! Сабуро!"
  ]
 },
 "2250": {
  "pages": [
   "Ой... братец Итиро..."
  ]
 },
 "2251": {
  "pages": [
   "Какой я тебе братец Итиро! Ну надо же!!"
  ]
 },
 "2252": {
  "pages": [
   "И Дзиро, и Сиро тоже..."
  ]
 },
 "2253": {
  "pages": [
   "Когда мы взялись за эту работу,",
   "я ведь велел вам молчать обо всем, что записываете!"
  ]
 },
 "2254": {
  "pages": [
   "Особенно ты, Дзиро! Ты меня очень разочаровал!",
   "Ты старший брат и должен держать младших в узде..."
  ]
 },
 "2255": {
  "pages": [
   "М... мне очень стыдно, братец..."
  ]
 },
 "2256": {
  "pages": [
   "Эх... Вам все еще недостает сознательности настоящих куроко.",
   "...Ну и братья мне достались..."
  ]
 },
 "2257": {
  "pages": [
   "Я дома-а!"
  ]
 },
 "2258": {
  "pages": [
   "А, Горо... Спасибо за труды..."
  ]
 },
 "2259": {
  "pages": [
   "Горо ведь приглядывал за Укио? Надо скорее продезинфицировать."
  ]
 },
 "2260": {
  "pages": [
   "Ах да, кстати... Это насчет Укио..."
  ]
 },
 "2261": {
  "pages": [
   "Я сегодня услышал. Представляете, Укио-то..."
  ]
 },
 "2262": {
  "pages": [
   "Э-эй... Горо!"
  ]
 },
 "2263": {
  "pages": [
   "Хранить тайны клиента - вот что",
   "значит быть профессионалом, верно?"
  ]
 },
 "2264": {
  "pages": [
   "Д-да, да..."
  ]
 },
 "2265": {
  "pages": [
   "Э-э... Но..."
  ]
 },
 "2266": {
  "pages": [
   "Что?! Укио сделал что?"
  ]
 },
 "2267": {
  "pages": [
   "За каждым подвигом самураев стоят куроко...",
   "Почему бы порой не вспомнить",
   "о безвестных героях Самурай Шодаун..."
  ]
 },
 "2268": {
  "pages": [
   "Ха-ха-ха-ха!"
  ]
 },
 "2269": {
  "pages": [
   "Твой сын уже стал частью моего тела!"
  ]
 },
 "2270": {
  "pages": [
   "Такой неумеха, как ты, будет лишь обузой...",
   "Оставайся с матерью и жди добрых вестей..."
  ]
 },
 "2271": {
  "pages": [
   "Дорогой..."
  ]
 },
 "2272": {
  "pages": [
   "Я не прошу понять меня..."
  ]
 },
 "2273": {
  "pages": [
   "Кто против - может убить меня как ниндзя-отступника."
  ]
 },
 "2274": {
  "pages": [
   "Не тревожьтесь...",
   "Уничтожить Амакусу - почти приказ сегуната. Это не личная распря."
  ]
 },
 "2275": {
  "pages": [
   "Мы все едины... Положитесь на наше разумение и оставьте прочее нам..."
  ]
 },
 "2276": {
  "pages": [
   "...Простите."
  ]
 },
 "2277": {
  "pages": [
   "Благодаря стараниям самураев",
   "и Хандзо, поддерживавшему их из тени,",
   "демон Амакуса Сиро погиб вместе со своим небесным замком."
  ]
 },
 "2278": {
  "pages": [
   "Хандзо сумел вернуть тело Амакусы Сиро...",
   "нет, тело своего сына Синдзо."
  ]
 },
 "2279": {
  "pages": [
   "Однако..."
  ]
 },
 "2280": {
  "pages": [
   "Не может быть... Брат!"
  ]
 },
 "2281": {
  "pages": [
   "О-ох...",
   "Н-нет... не может быть... Дорогой...!"
  ]
 },
 "2282": {
  "pages": [
   "Надежды нет..."
  ]
 },
 "2283": {
  "pages": [
   "Душу Синдзо уже пожрал мир демонов..."
  ]
 },
 "2284": {
  "pages": [
   "З-значит, мой брат...!"
  ]
 },
 "2285": {
  "pages": [
   "Живой мертвец..."
  ]
 },
 "2286": {
  "pages": [
   "Н-нет! Брат!"
  ]
 },
 "2287": {
  "pages": [
   "Но, Синдзо, я не отпущу тебя одного...",
   "Я скоро последую за тобой."
  ]
 },
 "2288": {
  "pages": [
   "Кандзо, позаботься о Каэдэ...",
   "Стань достойным ниндзя!"
  ]
 },
 "2289": {
  "pages": [
   "Отец... Прошу, одумайтесь!"
  ]
 },
 "2290": {
  "pages": [
   "Постойте! Мастер Хандзо!"
  ]
 },
 "2291": {
  "pages": [
   "Мастер Хандзо! Не торопитесь!"
  ]
 },
 "2292": {
  "pages": [
   "Прошу, прошу, выслушайте нас!"
  ]
 },
 "2293": {
  "pages": [
   "Хм... Вы..."
  ]
 },
 "2294": {
  "pages": [
   "Мастер Хандзо, мы понимаем вашу скорбь..."
  ]
 },
 "2295": {
  "pages": [
   "Но подумайте о тех, кого оставите,",
   "о нас, о госпоже Каэдэ и юном Кандзо!"
  ]
 },
 "2296": {
  "pages": [
   "Что без вас станется с сегунатом?",
   "Никто не поручится, что не явится",
   "второй или третий Амакуса!"
  ]
 },
 "2297": {
  "pages": [
   "...И все же..."
  ]
 },
 "2298": {
  "pages": [
   "Тайное искусство ниндзя Ига! Возвращение души резонансом!"
  ]
 },
 "2299": {
  "pages": [
   "М... матушка!"
  ]
 },
 "2300": {
  "pages": [
   "Каэдэ! Что ты делаешь?!"
  ]
 },
 "2301": {
  "pages": [
   "Это запретная техника, возвращающая душу ценой собственной жизни..."
  ]
 },
 "2302": {
  "pages": [
   "Н-не может быть... Госпожа Каэдэ, вы хотите отдать жизнь?!"
  ]
 },
 "2303": {
  "pages": [
   "Каэдэ..."
  ]
 },
 "2304": {
  "pages": [
   "О... отец..."
  ]
 },
 "2305": {
  "pages": [
   "Отец! Брат... Брат пришел в себя!"
  ]
 },
 "2306": {
  "pages": [
   "...Он спасен... Твоя техника... удалась."
  ]
 },
 "2307": {
  "pages": [
   "М-матушка... Матушка-а!"
  ]
 },
 "2308": {
  "pages": [
   "Брат... Как я рад, что ты жив..."
  ]
 },
 "2309": {
  "pages": [
   "Хорошо... Эта жизнь моя однажды уже умерла...",
   "Я вверяю ее вам..."
  ]
 },
 "2310": {
  "pages": [
   "А... Кандзо, это ты?"
  ]
 },
 "2311": {
  "pages": [
   "Я наконец достиг возраста, чтобы начать те же тренировки, что и ты, брат...",
   "Смиренно прошу наставлять меня!"
  ]
 },
 "2312": {
  "pages": [
   "Вот как... Отец учит сурово.",
   "Без истинной решимости ты даже не поспеешь."
  ]
 },
 "2313": {
  "pages": [
   "А ты сам, брат? Как твое здоровье?"
  ]
 },
 "2314": {
  "pages": [
   "Я намерен заново закалять себя...",
   "Эта история показала мне, как я еще неопытен..."
  ]
 },
 "2315": {
  "pages": [
   "Путь ниндзя",
   "тяжелее, чем вы оба можете вообразить...",
   "Переживите смерть матери и превзойдите искусство отца!"
  ]
 },
 "2316": {
  "pages": [
   "...Знайте: это и будет лучшей памятью о покойной Каэдэ..."
  ]
 },
 "2317": {
  "pages": [
   "Да! Отец!"
  ]
 },
 "2318": {
  "pages": [
   "Я понимаю...",
   "Пусть у меня нет таланта, но всем сердцем и душой..."
  ]
 },
 "2319": {
  "pages": [
   "Хорошо... Ступайте!"
  ]
 },
 "2320": {
  "pages": [
   "Благодаря стараниям самураев Амакуса Сиро был уничтожен."
  ]
 },
 "2321": {
  "pages": [
   "Сирануи Гэн-ан, возомнивший себя королем мира демонов,",
   "с ликованием вернулся с триумфом на родину, на остров Онинаки."
  ]
 },
 "2322": {
  "pages": [
   "Пал, пал, низвергся! Нкекеке..."
  ]
 },
 "2323": {
  "pages": [
   "Амакуса тоже пал во тьму,",
   "так что теперь истинный Король демонов - это я, кэ!"
  ]
 },
 "2324": {
  "pages": [
   "Дорогой... неужели это ты...?",
   "Ты вернулся домой!"
  ]
 },
 "2325": {
  "pages": [
   "О, Адзами!"
  ]
 },
 "2326": {
  "pages": [
   "Радуйся, я Король демонов!"
  ]
 },
 "2327": {
  "pages": [
   "Поздравляю... Ты наконец постиг темные искусства."
  ]
 },
 "2328": {
  "pages": [
   "Надо приготовить сегодня пир...",
   "Темный котел из припасенного удильщика и демонической сороконожки, самый зловещий!"
  ]
 },
 "2329": {
  "pages": [
   "Да и Дзакуро с Мукуро так подросли... хи-хи."
  ]
 },
 "2330": {
  "pages": [
   "...Что с тобой, дорогой..."
  ]
 },
 "2331": {
  "pages": [
   "Адзами, я не могу вернуться..."
  ]
 },
 "2332": {
  "pages": [
   "Нет, я НЕ вернусь, кэ."
  ]
 },
 "2333": {
  "pages": [
   "?! П-почему..."
  ]
 },
 "2334": {
  "pages": [
   "Я еще не до конца постиг темные искусства."
  ]
 },
 "2335": {
  "pages": [
   "Добыча невиданных миров зовет меня,",
   "умоляет низвергнуть ее во тьму."
  ]
 },
 "2336": {
  "pages": [
   "Как король тьмы, я должен пить кровь жертв,",
   "вырывать им хребты и пожирать мертвечину",
   "вечно, кэ!"
  ]
 },
 "2337": {
  "pages": [
   "Н-но, дорогой..."
  ]
 },
 "2338": {
  "pages": [
   "Ты ведь только-только вернулся...",
   "...Нет, обо мне не думай."
  ]
 },
 "2339": {
  "pages": [
   "Хотя бы... хотя бы взгляни на детей..."
  ]
 },
 "2340": {
  "pages": [
   "Не ходи за мной, кэ!"
  ]
 },
 "2341": {
  "pages": [
   "...На темном пути женщине не место!"
  ]
 },
 "2342": {
  "pages": [
   "Прости, кэ..."
  ]
 },
 "2343": {
  "pages": [
   "Обман... Предательство... Угрозы... Провокации...",
   "Сирануи Гэн-ан, возомнивший себя королем тьмы,",
   "острыми когтями рвал на части несчастных жертв по всему миру."
  ]
 },
 "2344": {
  "pages": [
   "Шло время, и снова... остров Онинаки."
  ]
 },
 "2345": {
  "pages": [
   "...Кеке. Все темные дела я перепробовал,",
   "да только никого не стоило низвергать, кэ..."
  ]
 },
 "2346": {
  "pages": [
   "Наконец-то я тебя нашла, Сирануи Гэн-ан!"
  ]
 },
 "2347": {
  "pages": [
   "...А ты кто?"
  ]
 },
 "2348": {
  "pages": [
   "Я пришла забрать твою жизнь.",
   "...Сразись со мной!"
  ]
 },
 "2349": {
  "pages": [
   "Нкекеке!",
   "Чем больше на тебя смотрю, тем противнее ты, кэ!"
  ]
 },
 "2350": {
  "pages": [
   "Но раз ты женщина, поблажек не жди."
  ]
 },
 "2351": {
  "pages": [
   "Хватит болтать, нападай!"
  ]
 },
 "2352": {
  "pages": [
   "Или ты меня боишься?"
  ]
 },
 "2353": {
  "pages": [
   "Нке-е-е! Убью-у-у!"
  ]
 },
 "2354": {
  "pages": [
   "Иду!"
  ]
 },
 "2355": {
  "pages": [
   "Нкекеке-е-е!"
  ]
 },
 "2356": {
  "pages": [
   "Ха!"
  ]
 },
 "2357": {
  "pages": [
   "Н-не может бы-ыть!"
  ]
 },
 "2358": {
  "pages": [
   "Ты потерял бдительность, Сирануи Гэн-ан!"
  ]
 },
 "2359": {
  "pages": [
   "Твое зазнайство, король тьмы, тебя и погубило."
  ]
 },
 "2360": {
  "pages": [
   "А-А-Адзами-и-и!!"
  ]
 },
 "2361": {
  "pages": [
   "Хо-хо-хо-хо!"
  ]
 },
 "2362": {
  "pages": [
   "Браво! Лучшая в Японии!"
  ]
 },
 "2363": {
  "pages": [
   "Что-то сегодня у меня странно шепчет костный мозг...",
   "Ах! Это же..."
  ]
 },
 "2364": {
  "pages": [
   "Так и есть! Оружие господина Гэн-ана! Ох... как же так..."
  ]
 },
 "2365": {
  "pages": [
   "Я всегда боялась, что когда-нибудь так и случится...",
   "Дорогой..."
  ]
 },
 "2366": {
  "pages": [
   "Ой... тут что-то вырезано...",
   "А... дза... ми...?"
  ]
 },
 "2367": {
  "pages": [
   "Адзами?",
   "Ох... господин Гэн-ан... Вы вырезали мое имя на оружии..."
